# ─────────────────────────────────────────────────────────────────────────────
# BountyLoop — Environment Variables Template
# Copy to .env and fill in your values. NEVER commit .env.
# Variables marked [PHASE N] are first needed in that phase.
# ─────────────────────────────────────────────────────────────────────────────

# ── App (Phase 0) ─────────────────────────────────────────────────────────────
APP_ENV=development          # development | staging | production
APP_VERSION=0.1.0
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ── API server (Phase 0) ──────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database / PostGIS (Phase 0) ──────────────────────────────────────────────
POSTGRES_USER=bountyloop
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bountyloop
# Async URL for SQLAlchemy (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://bountyloop:changeme@db:5432/bountyloop
# Sync URL for Alembic
DATABASE_URL_SYNC=postgresql+psycopg://bountyloop:changeme@db:5432/bountyloop

# ── CV service (Phase 0 stub → Phase 3 real) ──────────────────────────────────
CV_SERVICE_URL=http://cv:8001
CV_TIMEOUT_SECONDS=10
CV_MAX_RETRIES=1

# ── Firebase Auth (Phase 2) ────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-firebase-project-id
# Service account credentials (newline as \n):
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n
# Web API key (safe to expose to frontend, do NOT use in backend auth)
FIREBASE_WEB_API_KEY=your-web-api-key

# ── Rate limiting (Phase 2) ────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60

# ── CV model configuration (Phase 3) ──────────────────────────────────────────
AUTO_CONF=0.90               # confidence >= this → auto-create donation
CONFIRM_CONF=0.60            # confidence >= this → ask donor to confirm
HAZARD_FORCES_REVIEW=true    # any hazard flag → human review queue
MAX_UPLOAD_MB=10             # maximum photo upload size in MB
TTA=true                     # test-time augmentation (hflip + centre crop)

# ── Impact calculation factors (Phase 5/10) ───────────────────────────────────
MEAL_KG_FACTOR=1.2           # kg per meal equivalent (source: FAO est.)
IMPACT_CO2E_FACTOR=2.5       # kg CO2e per kg food waste avoided (UNVERIFIED — mark as estimate)

# ── Matching engine (Phase 7) ─────────────────────────────────────────────────
MAX_RADIUS_KM=15.0           # maximum donor-to-recipient matching radius
MAX_CONSECUTIVE_WINS=3       # equity guard: max consecutive claims per recipient
OFFER_TTL_MINUTES=30         # how long before an unaccepted offer expires

# ── MCP servers (Phase 9) ─────────────────────────────────────────────────────
MCP_TRANSPORT=streamable-http          # stdio | streamable-http
MCP_DONATION_LEDGER_URL=http://localhost:8010
MCP_ROUTING_URL=http://localhost:8011
MCP_NOTIFY_URL=http://localhost:8012
MCP_CHARITY_DIRECTORY_URL=http://localhost:8013
INTERNAL_SERVICE_TOKEN=changeme-internal-token

# ── Agent / LLM (Phase 9) ─────────────────────────────────────────────────────
AGENT_ENABLED=false          # false = manual matching (Phase 7 fallback)
LLM_PROVIDER=openai          # openai | anthropic | google
LLM_MODEL=gpt-4o-mini        # cheapest capable tier
LLM_API_KEY=your-llm-api-key
AGENT_MAX_CALLS_PER_DAY=500

# ── Twilio SMS (Phase 9) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890
SMS_DAILY_CAP=20             # hard cap — push is primary, SMS is fallback

# ── Forecast feature flags (Phase 11) ─────────────────────────────────────────
FORECAST_PROMPTS_ENABLED=false

# ── Sentry observability (Phase 12) ───────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ── OSRM routing (Phase 7/13) ─────────────────────────────────────────────────
OSRM_URL=http://osrm:5000
# If OSRM is unavailable, fall back to straight-line estimate
OSRM_FALLBACK_TO_ESTIMATE=true
